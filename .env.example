# ─── Configuration SIV (identification véhicule par plaque) ──────────────
#
# En développement, laissez ces variables vides : le mock local est utilisé
# (aucun appel réseau). Pour basculer en mode "vraie API" :
#
#   1. Copier ce fichier en .env.local
#   2. Mettre NEXT_PUBLIC_USE_REAL_SIV=true
#   3. Choisir un driver via SIV_PROVIDER
#   4. Renseigner les credentials correspondants
#
# Les variables NEXT_PUBLIC_* sont exposées au navigateur (requis pour le switch
# côté front). Les autres restent strictement côté serveur (route API).

# Active le mode "vraie API" côté front
# false (défaut) = mock local, true = appel vers /api/siv/:plate
NEXT_PUBLIC_USE_REAL_SIV=false

# Driver utilisé par la route serveur
# mock | autobacs-internal | aaadata | apiplaqueimmat
SIV_PROVIDER=mock

# URL de base du fournisseur (selon driver, PAS requis pour apiplaqueimmat)
# Autobacs interne  : https://api.autobacs.internal
# AAA DATA          : https://api.aaa-data.fr/sivin/v1
SIV_API_URL=

# Clé / token d'authentification
SIV_API_KEY=

# Identifiant client (utilisé par AAA DATA notamment)
SIV_CLIENT_ID=

# Active le fallback automatique vers le mock si le fournisseur est KO
# Recommandé en prod kiosque pour que la borne reste utilisable même si
# l'API tierce tombe en panne.
SIV_FALLBACK_MOCK=true

# ─── Configuration catalogue pièces (plate/K-type → SKU compatibles) ─────
# À compléter quand on branchera l'endpoint catalogue Autobacs (K-type → produits).
# CATALOG_API_URL=
# CATALOG_API_KEY=
